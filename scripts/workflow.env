# Read by check-tests-touched.sh. Extended regexes over repo-relative paths. Edit per repo.
SRC_RE='^packages/[^/]+/src/'
TEST_RE='(\.(test|spec)\.[jt]sx?$|(^|/)tests?/|_test\.(go|py|rs)$|(^|/)test_[^/]*\.py$)'
# Source lines that count as an added inline test; empty = only test files count.
INLINE_RE='#\[test\]|#\[cfg\(test\)\]'
