{
  "name": "@eleoptics/plots-svelte",
  "version": "0.1.0",
  "description": "Svelte 5 components for @eleoptics/plots: PlotCard, Layout2D, Map2D, SpotDiagram and more, redrawn on theme change.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ELEOptics/eleo-ui.git",
    "directory": "packages/plots-svelte"
  },
  "homepage": "https://eleoptics.com",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@eleoptics/plots": "^0.1.0",
    "@eleoptics/tokens": "^0.1.0"
  },
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "prepack": "cp ../../LICENSE LICENSE"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
